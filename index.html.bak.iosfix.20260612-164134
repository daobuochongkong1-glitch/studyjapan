  aside { width: 220px; background: white; border-right: 1px solid #e1e5e9; padding: 16px 0; overflow-y: auto; position: sticky; top: 0; height: 100vh; }
  aside .lesson-btn { display: flex; justify-content: space-between; align-items: center; padding: 10px 18px; cursor: pointer; font-size: 14px; border-left: 3px solid transparent; transition: all 0.15s; }
