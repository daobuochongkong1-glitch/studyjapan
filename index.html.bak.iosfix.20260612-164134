// === Audio (multi-voice TTS) ===
const voiceInfo = document.getElementById('voice-info');
const voiceSelect = document.getElementById('voice-select');
const MAZII_AUDIO = '/tts/mazii.mp3?q=';   // same-origin proxy có cache (qua Cloudflare)
const GOOGLE_TTS = '/tts/google.mp3?q=';   // same-origin proxy có cache (qua Cloudflare)

const VOICE_MODES = {
  google: { label: '🔊 Google Dịch (giọng nữ tự nhiên)', color: '#2980b9', url: t => GOOGLE_TTS + encodeURIComponent(t) },
  mazii:  { label: '🔊 Mazii.net (giọng người Nhật)',     color: '#16a085', url: t => MAZII_AUDIO + encodeURIComponent(t) },
  browser:{ label: '🔊 TTS trình duyệt (giọng máy)',       color: '#8e44ad', url: null }
};
let currentVoiceMode = localStorage.getItem('voice-mode') || 'google';
if (!VOICE_MODES[currentVoiceMode]) currentVoiceMode = 'google';

function updateVoiceInfo() {
  const v = VOICE_MODES[currentVoiceMode];
  voiceInfo.textContent = v.label;
  voiceInfo.style.color = v.color;
}
voiceSelect.value = currentVoiceMode;
voiceSelect.addEventListener('change', () => {
  currentVoiceMode = voiceSelect.value;
  localStorage.setItem('voice-mode', currentVoiceMode);
  audioCache.clear();  // different voice → drop cached audio
  updateVoiceInfo();
});
updateVoiceInfo();

const audioCache = new Map();   // key = mode + '|' + text
let currentBtn = null;
let currentAudio = null;
let currentSpeechUtterance = null;

function stopCurrentAudio() {
  if (currentAudio) {
    try { currentAudio.pause(); } catch {}
    currentAudio.onended = null;
    currentAudio.onerror = null;
  }
  if (currentSpeechUtterance && window.speechSynthesis) {
    try { window.speechSynthesis.cancel(); } catch {}
  }
  if (currentBtn) currentBtn.classList.remove('playing');
  currentAudio = null;
  currentSpeechUtterance = null;
}

function pickJapaneseVoice() {
  if (!window.speechSynthesis) return null;
  const voices = window.speechSynthesis.getVoices();
  // Prefer premium voices in this order
  const prefer = ['Kyoko', 'Otoya', 'Haruka', 'Sayaka', 'Google 日本語', 'Microsoft Nanami', 'Microsoft Ayumi'];
  for (const name of prefer) {
    const v = voices.find(x => x.name.includes(name));
    if (v) return v;
  }
  return voices.find(v => v.lang && v.lang.toLowerCase().startsWith('ja')) || null;
}

function speak(text, rate, btn) {
  const cleanText = text.replace(/[～~]/g, '').replace(/[（）()]/g, '').trim();
  if (!cleanText) return;
  stopCurrentAudio();

  if (currentVoiceMode === 'browser') {
    if (!window.speechSynthesis) { console.warn('SpeechSynthesis unsupported'); return; }
    const u = new SpeechSynthesisUtterance(cleanText);
    u.lang = 'ja-JP';
    u.rate = rate;
    const jv = pickJapaneseVoice();
    if (jv) u.voice = jv;
    btn.classList.add('playing');
    currentBtn = btn;
    currentSpeechUtterance = u;
    u.onend = () => { btn.classList.remove('playing'); if (currentSpeechUtterance === u) currentSpeechUtterance = null; };
    u.onerror = u.onend;
    window.speechSynthesis.speak(u);
    return;
  }

  const cacheKey = currentVoiceMode + '|' + cleanText;
  let audio = audioCache.get(cacheKey);
  if (!audio) {
    audio = new Audio(VOICE_MODES[currentVoiceMode].url(cleanText));
    audio.preload = 'auto';
    audioCache.set(cacheKey, audio);
  }
  try { audio.currentTime = 0; } catch (e) {}
  audio.playbackRate = rate;
  if ('preservesPitch' in audio) audio.preservesPitch = true;

  btn.classList.add('playing');
  currentBtn = btn;
  currentAudio = audio;

  const cleanup = () => {
    btn.classList.remove('playing');
    if (currentBtn === btn) currentBtn = null;
    if (currentAudio === audio) currentAudio = null;
  };
  audio.onended = cleanup;
  audio.onerror = () => { console.warn('TTS error:', currentVoiceMode, cleanText); cleanup(); };
  audio.play().catch(e => { console.warn('Play failed:', e); cleanup(); });
}

// Trigger voices loading for SpeechSynthesis (Chrome lazy-loads them)
if (window.speechSynthesis) {
  window.speechSynthesis.onvoiceschanged = () => {};
  window.speechSynthesis.getVoices();
}

function bindAudioButtons() {
  document.querySelectorAll('.btn-play:not([data-bound])').forEach(btn => {
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      speak(btn.dataset.text, parseFloat(btn.dataset.rate), btn);
    });
  });
}

// === Đặt câu (Pre-generated N5 example sentences, curated by AI) ===
const LOCAL_EXAMPLES_URL = 'examples.json';
let localExamplesData = null;
let localExamplesPromise = null;

function loadLocalExamples() {
  if (localExamplesData) return Promise.resolve(localExamplesData);
  if (!localExamplesPromise) {
    localExamplesPromise = fetch(LOCAL_EXAMPLES_URL, {cache: 'force-cache'})
      .then(r => r.ok ? r.json() : {})
      .then(data => { localExamplesData = data; return data; })
      .catch(e => { console.warn('Load examples failed:', e); localExamplesData = {}; return {}; });
  }
  return localExamplesPromise;
}
// Prefetch in idle so first click is instant
if (window.requestIdleCallback) requestIdleCallback(loadLocalExamples);
else setTimeout(loadLocalExamples, 800);

async function fetchExamples(word) {
  const all = await loadLocalExamples();
  return all[word] || [];
}

// === Hội thoại theo bài (cumulative N5) ===
const LOCAL_DIALOGUES_URL = 'dialogues.json';
let localDialoguesData = null;
let localDialoguesPromise = null;

function loadLocalDialogues() {
  if (localDialoguesData) return Promise.resolve(localDialoguesData);
  if (!localDialoguesPromise) {
    localDialoguesPromise = fetch(LOCAL_DIALOGUES_URL, {cache: 'force-cache'})
      .then(r => r.ok ? r.json() : {})
      .then(d => { localDialoguesData = d; return d; })
      .catch(e => { console.warn('Dialogues load failed:', e); localDialoguesData = {}; return {}; });
  }
  return localDialoguesPromise;
}
if (window.requestIdleCallback) requestIdleCallback(loadLocalDialogues);
else setTimeout(loadLocalDialogues, 1200);

function renderDialogueHtml(num, dlg) {
  if (!dlg) return '<div class="dialogue-loading">⚠️ Chưa có hội thoại cho bài này.</div>';
  const colorByChar = {};
  (dlg.characters || []).forEach((c, i) => { colorByChar[c.id] = Math.min(i, 3); });
  const charsHtml = (dlg.characters || []).map(c =>
    `<span class="char-tag char-${colorByChar[c.id]}">${c.id}: <b>${c.name || ''}</b>${c.role ? ' — ' + c.role : ''}</span>`
  ).join('');
  const linesHtml = (dlg.lines || []).map((ln, i) => {
    const ci = colorByChar[ln.speaker] ?? 0;
    const safe = escapeAttr(ln.content || '');
    return `<div class="dlg-line char-row-${ci}" data-idx="${i}">
      <div class="dlg-speaker">${ln.speaker || ''}</div>
      <div class="dlg-text">
        <div class="dlg-jp">${ln.content || ''}</div>
        ${ln.transcription && ln.transcription !== ln.content ? `<div class="dlg-trans">${ln.transcription}</div>` : ''}
        <div class="dlg-mean">${ln.mean || ''}</div>
      </div>
      <div class="dlg-audio">
        <button class="btn-play" data-text="${safe}" data-rate="1">▶︎ 1×</button>
        <button class="btn-play btn-slow" data-text="${safe}" data-rate="0.75">▶︎ 0.75×</button>
      </div>
    </div>`;
  }).join('');
  return `<div class="dialogue-box">
    <div class="dlg-setting">📍 ${dlg.setting || ''}</div>
    <div class="dlg-characters">${charsHtml}</div>
    <div class="dlg-controls">
      <button class="btn-dlg-play" data-action="play-all">▶ Đọc cả đoạn (chậm 0.75×)</button>
      <button class="btn-dlg-stop" data-action="stop-all" style="display:none">⏹ Dừng</button>
    </div>
    <div class="dlg-lines">${linesHtml}</div>
  </div>`;
}

// Play all dialogue lines sequentially
let dialoguePlayState = null;

function stopDialogue() {
  if (!dialoguePlayState) return;
  dialoguePlayState.stopped = true;
  if (dialoguePlayState.audio) { try { dialoguePlayState.audio.pause(); } catch {} }
  if (dialoguePlayState.utterance && window.speechSynthesis) { try { window.speechSynthesis.cancel(); } catch {} }
}

async function playDialogueSequence(box) {
  if (dialoguePlayState) return;
  const lines = Array.from(box.querySelectorAll('.dlg-line'));
  if (!lines.length) return;
  const playBtn = box.querySelector('[data-action="play-all"]');
  const stopBtn = box.querySelector('[data-action="stop-all"]');
  playBtn.style.display = 'none';
  stopBtn.style.display = '';
  dialoguePlayState = {stopped: false, audio: null, utterance: null};
  for (const lineEl of lines) {
    if (dialoguePlayState.stopped) break;
    const text = lineEl.querySelector('.btn-play')?.dataset.text;
    if (!text) continue;
    lineEl.classList.add('now-playing');
    lineEl.scrollIntoView({behavior: 'smooth', block: 'center'});
    await new Promise(resolve => {
      if (currentVoiceMode === 'browser' && window.speechSynthesis) {
        const u = new SpeechSynthesisUtterance(text);
        u.lang = 'ja-JP';
        u.rate = 0.75;
        const jv = pickJapaneseVoice();
        if (jv) u.voice = jv;
        u.onend = resolve;
        u.onerror = resolve;
        dialoguePlayState.utterance = u;
        window.speechSynthesis.speak(u);
      } else {
        const audio = new Audio(VOICE_MODES[currentVoiceMode].url(text));
        audio.playbackRate = 0.75;
        if ('preservesPitch' in audio) audio.preservesPitch = true;
        audio.onended = resolve;
        audio.onerror = resolve;
        dialoguePlayState.audio = audio;
        audio.play().catch(resolve);
      }
    });
    lineEl.classList.remove('now-playing');
    if (!dialoguePlayState.stopped) await new Promise(r => setTimeout(r, 400));
  }
  playBtn.style.display = '';
  stopBtn.style.display = 'none';
  dialoguePlayState = null;
}

function bindDialogueButtons(box) {
  const playBtn = box.querySelector('[data-action="play-all"]');
  const stopBtn = box.querySelector('[data-action="stop-all"]');
  if (playBtn && !playBtn.dataset.bound) {
    playBtn.dataset.bound = '1';
    playBtn.addEventListener('click', () => playDialogueSequence(box));
  }
  if (stopBtn && !stopBtn.dataset.bound) {
    stopBtn.dataset.bound = '1';
    stopBtn.addEventListener('click', stopDialogue);
  }
}

async function appendDialogue(num) {
  const data = await loadLocalDialogues();
  const dlg = data[String(num)];
  const container = document.getElementById('dialogue-container');
  if (!container || container.dataset.lesson !== String(num)) return; // user switched lesson
  container.innerHTML = renderDialogueHtml(num, dlg);
  bindAudioButtons();
  bindDialogueButtons(container);
}

function renderExamples(items) {
  if (items === null) return '<div class="example-empty">⚠️ Không tải được ví dụ. Vui lòng thử lại.</div>';
  if (!items.length) return '<div class="example-empty">Chưa có câu ví dụ cho từ này.</div>';
  return items.map(ex => {
    const safe = escapeAttr(ex.content || '');
    return `<div class="example-item">
      <div class="ex-jp">${ex.content || ''}</div>
      ${ex.transcription && ex.transcription !== ex.content ? `<div class="ex-trans">${ex.transcription}</div>` : ''}
      <div class="ex-mean">→ ${ex.mean || ''}</div>
      <div class="ex-audio">
        <button class="btn-play" data-text="${safe}" data-rate="1">▶︎ 1×</button>
        <button class="btn-play btn-slow" data-text="${safe}" data-rate="0.75">▶︎ 0.75×</button>
      </div>
    </div>`;
  }).join('');
}

function bindExampleButtons() {
  document.querySelectorAll('.btn-example:not([data-bound])').forEach(btn => {
    btn.dataset.bound = '1';
    btn.addEventListener('click', async () => {
      const tr = btn.closest('tr');
      const next = tr.nextElementSibling;
      if (next && next.classList.contains('example-row')) {
        next.remove();
        btn.classList.remove('open');
        btn.textContent = '📝 Đặt câu';
        return;
      }
      btn.classList.add('open');
      btn.disabled = true;
      btn.textContent = '⏳ Đang tải...';
      const colspan = tr.children.length;
      const exTr = document.createElement('tr');
      exTr.className = 'example-row';
      exTr.innerHTML = `<td colspan="${colspan}"><div class="example-loading">Đang tải câu ví dụ từ Mazii...</div></td>`;
      tr.after(exTr);
      const items = await fetchExamples(btn.dataset.word);
      exTr.querySelector('td').innerHTML = renderExamples(items);
      bindAudioButtons();
      btn.disabled = false;
      btn.textContent = '✕ Đóng';
    });
  });
}

// === Init: load lesson từ hash hoặc localStorage hoặc bài 1 ===
function getInitialLesson() {
  const hash = window.location.hash.match(/bai-(\d+)/);
  if (hash) return parseInt(hash[1]);
  const saved = parseInt(localStorage.getItem('study-japan-lesson'));
  if (saved >= 1 && saved <= 25) return saved;
  return 1;
}
renderLesson(getInitialLesson());

// === Modal "Cách sử dụng" ===
const helpModal = document.getElementById('help-modal');
function openHelp() { helpModal.classList.add('show'); }
function closeHelp() { helpModal.classList.remove('show'); }
document.getElementById('btn-help').addEventListener('click', openHelp);
document.getElementById('help-close').addEventListener('click', closeHelp);
helpModal.addEventListener('click', e => { if (e.target === helpModal) closeHelp(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape' && helpModal.classList.contains('show')) closeHelp(); });
// Tự động hiện lần đầu truy cập
if (!localStorage.getItem('study-japan-help-shown')) {
  setTimeout(openHelp, 700);
  localStorage.setItem('study-japan-help-shown', '1');
}
</script>
