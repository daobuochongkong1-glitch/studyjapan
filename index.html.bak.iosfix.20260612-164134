// === Render ===
const contentEl = document.getElementById('content');
const titleEl = document.getElementById('lesson-title');
const metaEl = document.getElementById('lesson-meta');
const summaryEl = document.getElementById('lesson-summary');
const searchEl = document.getElementById('search');

function escapeAttr(s) { return s.replace(/"/g, '&quot;').replace(/'/g, "\\'"); }

function cleanForSpeak(text, dropBrackets) {
  let s = text.replace(/[（(][^)）]*[)）]/g, '');
  s = dropBrackets
    ? s.replace(/[\[［][^\]］]*[\]］]/g, '')
    : s.replace(/[\[\]［］]/g, '');
  return s.replace(/\s+/g, ' ').trim();
}

const KANJI_RE = /([㐀-䶿一-鿿々ヶ]+)[（(]([぀-ゟー]+)[)）]/g;

function toRuby(text) {
  return text.replace(KANJI_RE, '<ruby>$1<rt>$2</rt></ruby>');
}

function toHiragana(text) {
  return text
    .replace(KANJI_RE, '$2')
    .replace(/[\[\]［］]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

function audioCell(text, dropBrackets) {
  const safe = escapeAttr(cleanForSpeak(text, dropBrackets));
  return `<td class="audio-cell">
    <button class="btn-play" data-text="${safe}" data-rate="1">▶︎ 1×</button><br>
    <button class="btn-play btn-slow" data-text="${safe}" data-rate="0.75">▶︎ 0.75×</button><br>
    <button class="btn-example" data-word="${safe}">📝 Đặt câu</button>
  </td>`;
}

function renderTable4(rows) {
  let h = '<div class="table-wrap"><table class="searchable"><thead><tr><th class="stt">#</th><th>Từ vựng</th><th>Phiên âm</th><th class="han-tu">Hán tự</th><th>Âm Hán</th><th>Nghĩa</th><th>Audio</th></tr></thead><tbody>';
  rows.forEach((r, i) => {
    const speak = r[0] || r[1];
    const hira = cleanForSpeak(r[0], true);
    const showHira = hira && hira !== r[0].trim();
    h += `<tr><td class="stt">${i+1}</td><td class="tu-vung">${r[0]}${r[1] ? `<span class="han-tu-inline">${r[1]}</span>` : ''}</td><td class="phien-am">${showHira ? hira : ''}</td><td class="han-tu">${r[1]}</td><td class="am-han">${r[2]}</td><td class="nghia">${r[3]}</td>${audioCell(speak, true)}</tr>`;
  });
  return h + '</tbody></table></div>';
}

function renderTable2(rows) {
  let h = '<div class="table-wrap"><table class="searchable"><thead><tr><th class="stt">#</th><th>Tiếng Nhật</th><th>Phiên âm</th><th>Nghĩa</th><th>Audio</th></tr></thead><tbody>';
  rows.forEach((r, i) => {
    const hira = toHiragana(r[0]);
    const display = toRuby(r[0]);
    const showHira = hira !== r[0].trim();
    h += `<tr><td class="stt">${i+1}</td><td class="tu-vung">${display}</td><td class="phien-am">${showHira ? hira : ''}</td><td class="nghia">${r[1]}</td>${audioCell(r[0], false)}</tr>`;
  });
  return h + '</tbody></table></div>';
}

function renderLesson(num) {
  const l = LESSONS[num];
  if (!l) { contentEl.innerHTML = '<div class="empty">Không tìm thấy bài.</div>'; return; }

  titleEl.textContent = `Bài ${num}`;
  metaEl.textContent = l.title;

  const total = l.vocab.length + l.sentences.length + l.countries.length + l.proper_nouns.length;
  summaryEl.innerHTML = `
    <span class="badge">Từ vựng: <b>${l.vocab.length}</b></span>
    <span class="badge">Mẫu câu: <b>${l.sentences.length}</b></span>
    <span class="badge">Tên nước: <b>${l.countries.length}</b></span>
    <span class="badge">Tên riêng: <b>${l.proper_nouns.length}</b></span>
    <span class="badge">Tổng: <b>${total}</b></span>`;

  let html = '';
  if (l.vocab.length) html += '<h2>1. Từ vựng chính</h2>' + renderTable4(l.vocab);
  if (l.sentences.length) html += '<h2>2. Mẫu câu / Cụm hội thoại</h2>' + renderTable2(l.sentences);
  if (l.countries.length) html += '<h2>3. Tên nước / Từ ngắn</h2>' + renderTable2(l.countries);
  if (l.proper_nouns.length) html += '<h2>4. Tên riêng</h2>' + renderTable2(l.proper_nouns);
  if (!html) html = '<div class="empty">Bài này chưa có dữ liệu.</div>';
  // Dialogue section placeholder (filled async)
  html += '<h2>💬 Hội thoại làm quen (cumulative Bài 1-' + num + ')</h2>';
  html += '<div id="dialogue-container" data-lesson="' + num + '"><div class="dialogue-loading">⏳ Đang tải hội thoại...</div></div>';
  contentEl.innerHTML = html;

  // Stop any playing dialogue from a previous lesson
  stopDialogue();

  bindAudioButtons();
  bindExampleButtons();
  appendDialogue(num);
  searchEl.value = '';

  document.querySelectorAll('.lesson-btn').forEach(b => {
    b.classList.toggle('active', parseInt(b.dataset.lesson) === num);
  });

  // Lưu state
  localStorage.setItem('study-japan-lesson', num);
  history.replaceState(null, '', `#bai-${num}`);

  document.getElementById('sidebar').classList.remove('open');
}

